DATABASE_URL=postgresql://postgres:<password>@localhost:5432/loka_exchange_dev
TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/loka_exchange_test

# Privy (login): app ID and secret from the Privy dashboard
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ID Analyzer (KYB): the legacy server API key from portal2.idanalyzer.com (API keys > Legacy API Keys).
# Fine-grained keys have no DocuPass scope and get 403 ERROR_KEY_FORBIDDEN on /docupass.
IDANALYZER_API_KEY=
IDANALYZER_WEBHOOK_SECRET=
# KYC profile used for DocuPass (portal: KYC profiles). Not a secret.
IDANALYZER_KYC_PROFILE_ID=
# Optional: a key for the person checks (DocuPass, AML) on another account; the KYC profile must be on that account.
# Falls back to IDANALYZER_API_KEY.
IDANALYZER_KYC_API_KEY=

# Optional: Privy JWT verification key (public). Fetched from Privy if empty.
PRIVY_VERIFICATION_KEY=

# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:8000
